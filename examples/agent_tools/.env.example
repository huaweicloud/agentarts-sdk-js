# agent_tools 示例环境变量模板
#
# 用法：cp .env.example .env，然后填入真实值。
# .env 已被根目录 .gitignore 忽略，不会提交；.env.example 会提交。
#
# 由 load-env.ts 在启动时读取（import 副作用），规则：
#   - 真实的进程环境变量优先，.env 不会覆盖已存在的变量
#   - 值为空的行会被忽略，便于沿用代码里的默认值 / 回退变量
#   - 缺失 .env 不会报错
#
# 变量含义见 README.md「环境变量」一节。

# ── 模型凭据（二者其一必填，MODEL_API_KEY 优先）───────────────────────────
MODEL_API_KEY=
# 也可以用 OPENAI_API_KEY 作为回退
# OPENAI_API_KEY=

# ── 模型 API Base URL（可选）──────────────────────────────────────────────
BASE_URL=
# 也可以用 OPENAI_BASE_URL 作为回退
# OPENAI_BASE_URL=

# ── 模型名称（可选，默认 DeepSeek-V3）────────────────────────────────────
OPENAI_MODEL_NAME=DeepSeek-V3

# ── 代码解释器（Code Interpreter）────────────────────────────────────────
# API Key（必填）
HUAWEICLOUD_SDK_CODE_INTERPRETER_API_KEY=
# 区域（必填），例如 cn-southwest-2
HUAWEICLOUD_SDK_REGION=
# 数据面端点（必填）：SDK 不会按 region 自动推导，缺失时请求 URL 会退化成相对路径
AGENTARTS_CODEINTERPRETER_DATA_ENDPOINT=
# 代码解释器名称（必填）
AGENTARTS_CODE_INTERPRETER_NAME=