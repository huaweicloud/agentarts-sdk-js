{
  "name": "agentarts-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Huawei Cloud AgentArts SDK for Node.js - monorepo",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "format": "prettier --write \"packages/**/src/**/*.ts\" \"tests/**/*.ts\"",
    "cli": "node packages/agentarts-sdk/dist/cli.js"
  },
  "devDependencies": {
    "@huaweicloud/huaweicloud-sdk-core": "3.1.222",
    "@huaweicloud/huaweicloud-sdk-iam": "3.1.222",
    "@huaweicloud/huaweicloud-sdk-swr": "3.1.222",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "commander": "^15.1.0",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.11",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  }
}
